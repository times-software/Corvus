# Set target to cfavg (average over configurations).
target_list { cfavg }
# Set property to average (xanes).
cfavg_target{ xanes }

# Set absorbing atom type.
absorbing_atom_type{ Co }

# Use cif file as structural input.
cif_input{ CaCoO2_dist.cif }

# Set absorption edge.
feff.edge{ K }

# These settings are not converged, but are fast.
feff.fms{ 2.0 0 0 0.0 0.0 40.0 }
feff.scf{ 2.0 0 30 0.1 0 }
