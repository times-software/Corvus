# Set target to feffXANES (we will later change this to XANES.
target_list { xanes }

# Set absorption edge.
feff.edge{ K }

# Set nohole
feff.corehole{ none }

# Set absorbing atom
absorbing_atom{ 2 }

# Define cluster (xyz format in angstrom)
cluster {
Cl 1.2100	1.2100	1.2100	
Ge 0.0		0.0	0.0
Cl 1.2100	-1.2100	-1.2100	
Cl -1.2100	1.2100	-1.2100	
Cl -1.2100	-1.2100	1.2100	
}
