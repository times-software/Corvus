# Make corvus run a loop
target_list { loop }
# Set the parameter to loop over (cif_input) and it's values (one cif file per line).
loop_parameter{
cif_input
CuSe2.cif
CuSe.cif
Cu2Se.cif
}

# Inside the loop, run configurational averaged xanes and xes
loop_target{ cfavg }
cfavg_target{ xanes xes }

# Set the edge
feff.edge{ K }

# Set the absorbing atom type
absorbing_atom_type{ Cu }
#write_input_only{ True }

multiprocessing_ncpu{ 1 }
