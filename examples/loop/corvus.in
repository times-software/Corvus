# Make corvus run a loop
target_list { loop }
# Set the parameter to loop over (cif_input) and it's values (one cif file per line).
loop_parameter{
cif_input
CuSe2.cif
CuSe.cif
Cu2Se.cif
}

# Inside the loop, run configurational averaged xanes and xes
loop_target{ cfavg }
cfavg_target{ xanes xes }

# Set the edge
feff.edge{ K }

# Set the absorbing atom type
absorbing_atom_type{ Cu }

# Uncomment the following if you just want corvus to write the feff.inp files
# but not run feff.
#write_input_only{ True }

# Other useful cards
#
# feff.scf{ rscf  imol   nscf  ca   nmix
# feff.scf{ 9.0   0     100   0.05 0   }
# rscf: scf radius - the default of 7.0 is usually well converged
# imol: for solids keep this value of 0
# nscf: number of scf iterations. If the scf doesn't converge, may need to increase
# ca:   scf convergence acceleration. A smaller number is safer but will take longer
#       usually keep this between 0.05 and 0.2
# nmix: If the scf doesn't converge, you can try changing this between 0 and about 10.
#
# feff.fms{rfms imol minv toler1 toler2 rdirec}
# feff.fms{9.0  0    0    0.0    0.0    40.0}
# rfms: cluster radius to use for fms
# imol: Keep this as 0 for solids.
# minv: Keep this at 0.
# toler1: Keep this at 0.0
# toler2: Keep this at 0.0
# rdirec: Keep this at 40.0

multiprocessing_ncpu{ 1 }
