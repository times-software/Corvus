# Set target to feffXANES (we will later change this to XANES.
target_list { loop }
loop_target{ cfavg }
cfavg_target{ xanes xes }
loop_parameter{
cif_input
CuSe2.cif
CuSe.cif
Cu2Se.cif
}
feff.edge{ K }
absorbing_atom_type{ Cu }
#write_input_only{ True }

# Make Corvus use FEFF for XANES.
#cif_input{corvus.cif}
#vasp_xdatcar{XDATCAR}
multiprocessing_ncpu{ 1 }
feff.MPI.CMD{ mpirun }
feff.MPI.ARGS{ -n 40 }
#feff.equivalence{ 0 }
